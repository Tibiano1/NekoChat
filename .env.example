# GEMINI_API_KEY or Nekochat_Api_Key: Required for Gemini AI API calls on the Cloudflare Worker.
# Configure this as a Cloudflare Worker secret:
#   npx wrangler secret put GEMINI_API_KEY
#   or: npx wrangler secret put Nekochat_Api_Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
Nekochat_Api_Key="MY_GEMINI_API_KEY"

# AI_MODEL: The Gemini model to use (default: gemini-2.5-flash)
AI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
